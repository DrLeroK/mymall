# =======================================================
# MyMall Next.js Frontend Environment Configuration
# =======================================================

# Base URL of the Express backend API engine
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Real-Time Socket.io Server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

# Public upload static assets base URL
NEXT_PUBLIC_UPLOADS_URL=http://localhost:5001/uploads

# Default store slug for direct storefront routing
NEXT_PUBLIC_DEFAULT_STORE_SLUG=urbantrend

# Mapbox Access Token for Delivery Location & Storefront Maps
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here

# Chapa Public Key for Telebirr / CBE Birr Ethiopian checkout
NEXT_PUBLIC_CHAPA_KEY=CHAPUBK_TEST-xxxxxx

# Node environment mode (development / production)
NODE_ENV=development
